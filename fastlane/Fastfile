default_platform(:ios)

SCHEME = "HKNewcomerGuide"
PROJECT = "HKNewcomerGuide.xcodeproj"
APP_ID = "com.mengmusanqian.hknewcomerguide"
TEAM_ID = "DDDFQ9Z58N"
MARKETING_VERSION = "1.0" # keep in sync with project.yml's MARKETING_VERSION

# The Xcode project is generated from project.yml, so it is not in git.
# Every lane that touches the project regenerates it first.
def generate_project
  sh("cd .. && xcodegen generate")
end

require "base64"
require "openssl"

# Accepts the .p8 however it was pasted into the secret: real PEM, PEM with
# Windows line endings, PEM flattened with literal \n, or base64 of any of
# those. OpenSSL rejects all but the first with "invalid curve name".
def p8_content
  raw = ENV.fetch("ASC_KEY_P8").dup
  raw = Base64.decode64(raw) unless raw.include?("BEGIN PRIVATE KEY")
  raw.gsub("\r\n", "\n").gsub("\r", "\n").gsub('\n', "\n").strip + "\n"
end

def asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID").strip
  issuer_id = ENV.fetch("ASC_ISSUER_ID").strip

  # app_store_connect_api_key hands the key to fastlane's own REST calls
  # (match, produce, latest_testflight_build_number - all of which have
  # worked). pilot's binary upload shells out to the separate `altool`
  # binary, though, which only reads keys from disk, and this action does
  # not write one there - so it fails past that point with a misleading
  # "file isn't in the correct format" instead of a key-not-found error.
  dir = File.expand_path("~/.appstoreconnect/private_keys")
  FileUtils.mkdir_p(dir)
  content = p8_content
  File.write(File.join(dir, "AuthKey_#{key_id}.p8"), content)

  # A real Apple .p8 is ~230-250 bytes: a header line, 2-3 base64 body lines,
  # a footer line. 151 bytes written in an earlier run is too short for
  # that shape - print line lengths (not content) to see if it's truncated.
  UI.message("p8 written: #{content.bytesize} bytes, line lengths: #{content.lines.map { |l| l.strip.length }}")
  begin
    OpenSSL::PKey::EC.new(content)
    UI.message("p8: OpenSSL parses it as a valid EC key")
  rescue => e
    UI.important("p8: OpenSSL could NOT parse it (#{e.message}) - the secret is likely truncated or malformed")
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: p8_content,
    in_house: false
  )
end

platform :ios do
  desc "Check the API key parses, without revealing it"
  lane :check_key do
    key = p8_content
    UI.message("length: #{key.length}")
    UI.message("lines: #{key.lines.count}")
    UI.message("first line: #{key.lines.first.to_s.strip}")
    UI.message("last line: #{key.lines.last.to_s.strip}")
    UI.message("key_id length: #{ENV.fetch('ASC_KEY_ID').strip.length} (expected 10)")
    UI.message("issuer_id length: #{ENV.fetch('ASC_ISSUER_ID').strip.length} (expected 36)")
    begin
      OpenSSL::PKey::EC.new(key)
      UI.success("OpenSSL parsed the key")
    rescue => e
      UI.user_error!("OpenSSL rejected the key: #{e.message}")
    end
  end
end

platform :ios do
  desc "Create the App Store Connect record (safe to re-run; no-op if it exists)"
  lane :create_app do
    # produce has no api_key option; it reads the key from the lane context
    # that app_store_connect_api_key populates.
    asc_api_key

    produce(
      app_identifier: "com.mengmusanqian.hknewcomerguide",
      app_name: "來港通",
      language: "Chinese (Traditional)",
      sku: "hknewcomerguide-001",
      platforms: ["ios"],
      # Required by App Store Connect only for the very first app on an account.
      company_name: "MENCIUS'S MOTHER EDUCATION PLANING LIMITED"
    )
  end

  desc "Create or fetch the App Store distribution certificate and profile"
  lane :certificates do
    setup_ci if ENV["CI"]
    match(
      api_key: asc_api_key,
      type: "appstore",
      readonly: false
    )
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    key = asc_api_key
    key_id = ENV.fetch("ASC_KEY_ID").strip
    issuer_id = ENV.fetch("ASC_ISSUER_ID").strip

    # Not readonly: the storage repo starts empty, so the first run has to
    # create the certificate. match reuses whatever is already stored, so this
    # stays idempotent and will not burn through the 3-certificate limit.
    match(api_key: key, type: "appstore", readonly: false)

    build = latest_testflight_build_number(
      api_key: key,
      app_identifier: "com.mengmusanqian.hknewcomerguide",
      initial_build_number: 0
    ) + 1

    generate_project

    # project.yml asks for automatic signing, which looks for a development
    # profile and ignores the App Store profile match just installed. Point the
    # freshly generated project at that profile instead.
    profile = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      targets: [SCHEME]
    )

    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      output_directory: "build",
      output_name: "LaiGangTong.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: { APP_ID => profile }
      }
    )

    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.message("ipa: #{ipa} (#{File.exist?(ipa.to_s) ? File.size(ipa) : 'missing'} bytes)")

    # pilot's binary upload shells out to altool's deprecated `--upload-app`,
    # which multiple open fastlane issues report as unreliable on Xcode 26 -
    # ours failed instantly with a misleading "isn't in the correct format"
    # that turned out to have nothing to do with the ipa (confirmed sound by
    # unzip -t in an earlier run). Apple's replacement, `--upload-package`,
    # does not go through pilot at all, so call it directly.
    app_numeric_id = Spaceship::ConnectAPI::App.find(APP_ID).id

    # Isolate whether altool's complaint is about auth or about the file: a
    # command with no file argument at all should never say "isn't in the
    # correct format" unless that string is really a generic auth failure.
    keep_going = ->(status) { UI.important("(continuing despite exit #{status.exitstatus} to gather more diagnostics)") }

    sh("ls -la #{File.expand_path('~/.appstoreconnect/private_keys')}", error_callback: keep_going)
    sh("xcrun altool --list-providers --apiKey #{key_id} --apiIssuer #{issuer_id}", error_callback: keep_going)

    sh(
      "xcrun altool --upload-package '#{ipa}'" \
      " --type ios" \
      " --apple-id #{app_numeric_id}" \
      " --bundle-id #{APP_ID}" \
      " --bundle-version #{build}" \
      " --bundle-short-version-string #{MARKETING_VERSION}" \
      " --apiKey #{key_id}" \
      " --apiIssuer #{issuer_id}"
    )
  end

  desc "Push metadata and screenshots to App Store Connect, then submit for review"
  lane :release do
    key = asc_api_key

    deliver(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,                      # skip the interactive HTML preview
      skip_binary_upload: true,         # the binary comes from the beta lane
      skip_screenshots: false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Push metadata and screenshots without submitting for review"
  lane :metadata_only do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
